{% extends 'base.html.twig' %}

{% block title %}Portefeuille{% endblock %}

{% block body %}
  <div id="app">
    <h1>Portefeuille Crypto (demo)</h1>

    <div v-if="!logged">
      <h3>Login</h3>
      <input v-model="loginEmail" placeholder="email" />
      <input v-model="loginPassword" type="password" placeholder="password" />
      <button @click="login">Se connecter</button>

      <h3>Inscription</h3>
      <input v-model="regEmail" placeholder="email" />
      <input v-model="regPassword" type="password" placeholder="password" />
      <button @click="register">S'inscrire</button>
    </div>

    <div v-else>
      <button @click="logout">Se déconnecter</button>
      <h3>Ajouter</h3>
      <input v-model="newSymbol" placeholder="BTC" />
      <input v-model.number="newQuantity" placeholder="quantité" />
      <button @click="create">Ajouter</button>

      <h3>Positions</h3>
      <ul>
        <li v-for="e in entries" :key="e.id">
          {{ e.symbol }} — {{ e.quantity }} — {{ e.price || '—' }}
          <button @click="remove(e.id)">Supprimer</button>
        </li>
      </ul>
    </div>
  </div>

  <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
  <script>
    const { createApp } = Vue;
    createApp({
      data() {
        return {
          loginEmail: '', loginPassword: '',
          regEmail: '', regPassword: '',
          entries: [], logged: false,
          newSymbol: '', newQuantity: 0
        }
      },
      methods: {
        async register() {
          await fetch('/api/register', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({email:this.regEmail,password:this.regPassword})});
          alert('inscrit — vous pouvez vous connecter');
        },
        async login(){
          const r = await fetch('/api/login', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({email:this.loginEmail,password:this.loginPassword})});
          if (r.ok) { this.logged = true; this.load(); } else { alert('erreur'); }
        },
        async logout(){ await fetch('/api/logout',{method:'POST'}); this.logged=false; this.entries=[]; },
        async load(){
          const r = await fetch('/api/portfolio');
          if (r.ok) { this.entries = await r.json(); }
        },
        async create(){
          await fetch('/api/portfolio',{method:'POST',headers:{'Content-Type':'application/json'}, body: JSON.stringify({symbol:this.newSymbol,quantity:this.newQuantity})});
          this.newSymbol=''; this.newQuantity=0; this.load();
        },
        async remove(id){ await fetch('/api/portfolio/'+id,{method:'DELETE'}); this.load(); }
      }
    }).mount('#app')
  </script>
{% endblock %}
